{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dayne",
  "version": "0.1.2",
  "identifier": "com.dayne.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data: blob: https://raw.githubusercontent.com;"
    },
    "windows": [
      {
        "title": "Dayne",
        "width": 1100,
        "height": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
